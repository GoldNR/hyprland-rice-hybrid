#!/usr/bin/env bash

NOCT_HIST="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/notification_history.json"
lockinfo="$HOME/.config/eww/scripts/cache/dunst-lock-info"
cd ~/.config/eww
touch "$lockinfo"

export toggle_icon=""

get_notif() {
  jq -c '
    .entries
    | sort_by(.notification.received_wall_ms) | reverse
    | map({
        id: .notification.id,
        appname: .notification.app_name,
        summary: (.notification.summary // ""),
        body: (.notification.body // "")
      })
  ' "$NOCT_HIST" 2>/dev/null || echo "[]"
}

toggle() {
  noctalia msg notification-dnd-toggle
  echo "icon_change" > "$lockinfo"
}

clear() {
  noctalia msg notification-clear-history
  echo "icon_change" > "$lockinfo"
}

get_icon() {
  count=$(get_notif | jq 'length')
  if [ "$count" -eq 0 ]; then
    echo ""
  else
    echo ""
  fi
}

if [ "$1" == "--once" ]; then
  get_notif
elif [ "$1" == "toggle" ]; then
  toggle
elif [ "$1" == "clear" ]; then
  clear
elif [ "$1" == "icons" ]; then
  is_paused=$(noctalia msg notification-dnd-status 2>/dev/null | grep -qi "on" && echo true || echo false)
  echo '{"toggle_icon": "'"$toggle_icon"'", "paused": '"$is_paused"', "icon": "'"$(get_icon)"'"}'
  tail -f "$lockinfo" | while read -r; do
    is_paused=$(noctalia msg notification-dnd-status 2>/dev/null | grep -qi "on" && echo true || echo false)
    echo '{"toggle_icon": "'"$toggle_icon"'", "paused": '"$is_paused"', "icon": "'"$(get_icon)"'"}'
  done
else
  get_notif
  inotifywait -m -e close_write -e moved_to -e create "$(dirname "$NOCT_HIST")" 2>/dev/null | while read -r dir event file; do
    if [ "$file" = "$(basename "$NOCT_HIST")" ]; then
    get_notif
    fi
  done
fi

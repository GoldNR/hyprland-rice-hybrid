#!/usr/bin/env bash

lat="" # Put your details here
lon="" # Put your details here
location="" # Put your details here

data=$(curl -s "https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&hourly=temperature_2m,weather_code&daily=temperature_2m_max,temperature_2m_min,weather_code&timezone=auto&forecast_days=7")

[ -z "$data" ] && { echo '{"location":"","current_temp_c":0,"current_temp_f":32,"current_desc":"","days":[]}'; exit 0; }

code_to_desc() {
  local c="$1"
  case "$c" in
    0) echo "Clear sky" ;;
    1|2|3) echo "Partly cloudy" ;;
    45|48) echo "Foggy" ;;
    51|53|55|56|57) echo "Drizzle" ;;
    61|63|65|66|67) echo "Rain" ;;
    71|73|75|77) echo "Snow" ;;
    80|81|82) echo "Rain showers" ;;
    85|86) echo "Snow showers" ;;
    95|96|99) echo "Thunderstorm" ;;
    *) echo "Unknown" ;;
  esac
}

code_to_emoji() {
  local c="$1"
  case "$c" in
    0) echo "☀️" ;;
    1|2|3) echo "⛅" ;;
    45|48) echo "🌫️" ;;
    51|53|55|56|57) echo "🌦️" ;;
    61|63|65|66|67) echo "🌧️" ;;
    71|73|75|77) echo "❄️" ;;
    80|81|82) echo "🌧️" ;;
    85|86) echo "❄️" ;;
    95|96|99) echo "⛈️" ;;
    *) echo "🌡️" ;;
  esac
}

hour_label() {
  local iso="$1"
  date -d "$iso" +"%-I%P" | sed 's/^0//'
}

c_to_f() { awk -v c="$1" 'BEGIN{printf "%.0f", c*9/5+32}'; }

current_temp_c=$(echo "$data" | jq -r '.current.temperature_2m')
current_temp_f=$(c_to_f "$current_temp_c")
current_code=$(echo "$data" | jq -r '.current.weather_code')
current_desc=$(code_to_desc "$current_code")

n_days=$(echo "$data" | jq '.daily.time | length')

days="[]"
for ((i=0; i<n_days; i++)); do
  d=$(echo "$data" | jq -r ".daily.time[$i]")
  mdate=$(date -d "$d" +"%-m/%-d")
  weekday=$(date -d "$d" +"%A")
  max_c=$(echo "$data" | jq -r ".daily.temperature_2m_max[$i]")
  min_c=$(echo "$data" | jq -r ".daily.temperature_2m_min[$i]")
  max_f=$(c_to_f "$max_c")
  min_f=$(c_to_f "$min_c")
  code=$(echo "$data" | jq -r ".daily.weather_code[$i]")
  desc=$(code_to_desc "$code")
  emoji=$(code_to_emoji "$code")

  # pull hourly entries whose date matches this day
  hourly=$(echo "$data" | jq -c --arg d "$d" '
    . as $root
    | [range(0; ($root.hourly.time | length)) | select($root.hourly.time[.] | startswith($d))] as $idxs
    | $idxs
    | map(select(($root.hourly.time[.] | split("T")[1] | split(":")[0] | tonumber) % 3 == 0))
    | map({time: $root.hourly.time[.], tempC: $root.hourly.temperature_2m[.]})
  ' 2>/dev/null)

  hourly_out="[]"
  while read -r h; do
    t=$(echo "$h" | jq -r '.time')
    tc=$(echo "$h" | jq -r '.tempC')
    tf=$(c_to_f "$tc")
    label=$(hour_label "$t")
    entry=$(jq -cn --arg label "$label" --argjson tc "$tc" --argjson tf "$tf" '{label:$label, tempC:$tc, tempF:$tf}')
    hourly_out=$(echo "$hourly_out" | jq -c --argjson e "$entry" '. + [$e]')
  done < <(echo "$hourly" | jq -c '.[]')

  day_obj=$(jq -cn --arg mdate "$mdate" --arg weekday "$weekday" --arg desc "$desc" --arg emoji "$emoji" \
    --argjson max_c "$max_c" --argjson min_c "$min_c" --argjson max_f "$max_f" --argjson min_f "$min_f" \
    --argjson idx "$i" --argjson hourly "$hourly_out" \
    '{idx:$idx, mdate:$mdate, weekday:$weekday, desc:$desc, emoji:$emoji, max_c:$max_c, min_c:$min_c, max_f:$max_f, min_f:$min_f, hourly:$hourly}')

  days=$(echo "$days" | jq -c --argjson d "$day_obj" '. + [$d]')
done

gen_graph() {
  local hourly="$1" idx="$2" unit="$3" field="$4"
  local n=$(echo "$hourly" | jq 'length')
  [ "$n" -eq 0 ] && return

  local width=460 height=180 padding_x=30 padding_y=30
  local plot_w=$(( width - padding_x*2 ))
  local plot_h=$(( height - padding_y*2 ))
  local min=$(echo "$hourly" | jq "[.[].${field}] | min")
  local max=$(echo "$hourly" | jq "[.[].${field}] | max")
  [ "$min" = "$max" ] && max=$((min+1))

  local points="" labels_svg="" i=0
  while read -r point; do
    local temp=$(echo "$point" | jq -r ".${field}")
    local label=$(echo "$point" | jq -r '.label')
    local x=$(awk -v i="$i" -v n="$n" -v w="$plot_w" -v pad="$padding_x" 'BEGIN{print pad + (n>1 ? i/(n-1) : 0)*w}')
    local y=$(awk -v t="$temp" -v mn="$min" -v mx="$max" -v h="$plot_h" -v pad="$padding_y" 'BEGIN{print pad + (1 - (t-mn)/(mx-mn)) * h}')
    points="$points ${x},${y}"
    local ylabel=$(awk -v y="$y" 'BEGIN{print y-8}')
    labels_svg="$labels_svg<text x=\"$x\" y=\"$((height-8))\" font-size=\"11\" fill=\"#999999\" text-anchor=\"middle\">$label</text>"
    labels_svg="$labels_svg<text x=\"$x\" y=\"$ylabel\" font-size=\"11\" fill=\"#ffffff\" text-anchor=\"middle\">${temp}°</text>"
    i=$((i+1))
  done < <(echo "$hourly" | jq -c '.[]')

  cat > "/tmp/weather_graph_${unit}_${idx}.svg" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 $width $height">
  <polyline points="$points" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  $labels_svg
</svg>
SVG
}

echo "$days" | jq -c '.[]' | while read -r d; do
  idx=$(echo "$d" | jq -r '.idx')
  hourly=$(echo "$d" | jq -c '.hourly')
  gen_graph "$hourly" "$idx" "c" "tempC"
  gen_graph "$hourly" "$idx" "f" "tempF"
done

jq -cn --arg location "$location" --argjson temp_c "$current_temp_c" --argjson temp_f "$current_temp_f" \
  --arg desc "$current_desc" --argjson days "$days" \
  '{location:$location, current_temp_c:$temp_c, current_temp_f:$temp_f, current_desc:$desc, days:$days}'

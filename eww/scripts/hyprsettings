#!/usr/bin/bash

CONF="$HOME/.config/hypr/hyprsettings-persist.lua"
if [ ! -f "$CONF" ]; then
  cat > "$CONF" <<'EOF'
return {
    gaps_in = 5,
    gaps_out = 20,
    border_size = 2,
    rounding = 10,
    blur_size = 8,
    blur_passes = 3,
}
EOF
fi

getoptions() {
  rounding=$(hyprctl getoption decoration.rounding -j | gojq -r -c '.int')
  gaps_in=$(hyprctl getoption general.gaps_in -j | gojq -r '.css' | awk '{print $1}')
  gaps_out=$(hyprctl getoption general.gaps_out -j | gojq -r '.css' | awk '{print $1}')
  border_size=$(hyprctl getoption general.border_size -j | gojq -r -c '.int')
  force_no_accel=$(hyprctl getoption input.force_no_accel -j | gojq -r '.bool')
  input_sensitivity=$(hyprctl getoption input.sensitivity -j | gojq -r -c '.float')
  touchpad_disable_while_typing=$(hyprctl getoption input.touchpad.disable_while_typing -j | gojq -r '.bool')
  touchpad_clickfinger_behavior=$(hyprctl getoption input.touchpad.clickfinger_behavior -j | gojq -r '.bool')
  blur=$(hyprctl getoption decoration.blur.enabled -j | gojq -r '.bool')
  blur_size=$(hyprctl getoption decoration.blur.size -j | gojq -r -c '.int')
  blur_passes=$(hyprctl getoption decoration.blur.passes -j | gojq -r -c '.int')
  blur_xray=$(hyprctl getoption decoration.blur.xray -j | gojq -r '.bool')
  nightlight=$(hyprctl getoption decoration.screen_shader -j | gojq -r -c '.str')

  if [[ "$nightlight" == *"nothing.frag" || "$nightlight" == "[[EMPTY]]" || "$nightlight" == "" ]]; then
    nightlight='false'
  else
    nightlight='true'
  fi

  echo -n '{'
  echo -n "\"rounding\":$rounding,"
  echo -n "\"gaps_in\":$gaps_in,"
  echo -n "\"gaps_out\":$gaps_out,"
  echo -n "\"border_size\":$border_size,"
  echo -n "\"force_no_accel\":$force_no_accel,"
  echo -n "\"input_sensitivity\":$input_sensitivity,"
  echo -n "\"touchpad_disable_while_typing\":$touchpad_disable_while_typing,"
  echo -n "\"touchpad_clickfinger_behavior\":$touchpad_clickfinger_behavior,"
  echo -n "\"blur\":$blur,"
  echo -n "\"blur_size\":$blur_size,"
  echo -n "\"blur_passes\":$blur_passes,"
  echo -n "\"blur_xray\":$blur_xray,"
  echo -n "\"nightlight\":$nightlight,"

  echo '"dummy":0}'
}

setoption() {
  local hyprkey="$1" val="$2" luakey

  hyprctl keyword "$hyprkey" "$val"

  case "$hyprkey" in
    general:gaps_in)        luakey="gaps_in" ;;
    general:gaps_out)       luakey="gaps_out" ;;
    general:border_size)    luakey="border_size" ;;
    decoration:rounding)    luakey="rounding" ;;
    decoration:blur:size)   luakey="blur_size" ;;
    decoration:blur:passes) luakey="blur_passes" ;;
    *) echo "setoption: no lua field mapped for $hyprkey" >&2; return 1 ;;
  esac

  if grep -qE "^\s*${luakey}\s*=" "$CONF"; then
    sed -i -E "s/^(\s*${luakey}\s*=\s*)[^,]+(,?)/\1${val}\2/" "$CONF"
  else
    sed -i "s/^}/    ${luakey} = ${val},\n}/" "$CONF"
  fi
}

getoptions

if [ "$1" == "set" ]; then
  setoption "$2" "$3"
  kill -USR1 "$(cat /tmp/hyprsettings.pid 2>/dev/null)" 2>/dev/null
  exit 0
fi

if [ "$1" == "--once" ]; then
  exit 0
elif [ "$1" == "tickle" ]; then
  kill -USR1 "$(cat /tmp/hyprsettings.pid 2>/dev/null)" 2>/dev/null
else
  echo $$ > /tmp/hyprsettings.pid
  trap 'getoptions' USR1
  while true; do
    sleep 10 &
    wait $!
    getoptions
  done
fi
